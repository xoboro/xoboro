.DS_Store
.gradle/
.idea/
*.iml
**/build/
build/
out/

.env
.env.*
!.env.example

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Runtime directories a local deployment creates. Anchored to the repository root on purpose: an
# unanchored `media/` also matches the `io/xoboro/server/media` source package, so every new file
# added there was silently absent from `git status`.
/data/
/media/
/cache/
/config/

# Plugin/tool state, not project source. Untracked and easy to sweep into a
# `git add -A`. Deliberately unanchored, unlike the runtime directories below:
# tooling creates one of these per working directory, so an anchored `/.omc/`
# leaves `web/.omc/` and every future subproject's copy staged. No source package
# is named `.omc`, so there is nothing for the loose match to catch by accident.
.omc/

# Kotlin compiler working state - session and error records, not source. `.dockerignore`
# already excluded it, so the build context was clean while `git status` was not: the
# directory only appears once a build runs, which is exactly when someone is most likely
# to stage everything.
.kotlin/

# Browser-automation output: screenshots and console logs written while checking a running
# instance. Unanchored for the same reason as `.omc/`. These are evidence for one investigation,
# not project source, and they are exactly the kind of file that reaches a commit through
# `git add -A` - a screenshot of a real library would carry titles and paths that must never be
# committed.
.playwright-mcp/

# Web UI build output and installed packages. `web/build/` is not listed because
# the `build/` rule above is unanchored and already covers it.
#
# `node_modules/` is unanchored for the same reason as `.omc/`: an anchored
# `/web/node_modules/` misses a root-level one, and running a JS tool from the
# repository root creates exactly that. There is no source package by either name.
node_modules/
/web/dist/
web/dist/

# Playwright MCP writes screenshots and traces of the running app here. A screenshot
# of a real library is real library data, and this repository never holds that.
.playwright-mcp/
*.png
