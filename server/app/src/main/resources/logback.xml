<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%date{ISO8601} %-5level [%thread] %logger{36} - %message%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="INFO" />

  <root level="${XOBORO_LOG_LEVEL:-INFO}">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>

