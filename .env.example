# Host port published by Docker Compose.
XOBORO_HTTP_PORT=25600

# Existing host directory mounted read-only at /media inside Xoboro.
XOBORO_MEDIA_PATH=./media

# Optional published image. Omit to build and run xoboro:local.
# XOBORO_IMAGE=ghcr.io/xoboro/xoboro:latest

# Optional reverse-proxy base path, for example /xoboro.
XOBORO_CONTEXT_PATH=
XOBORO_LOG_LEVEL=INFO

# Optional comma-separated physical peers allowed to supply Forwarded or
# X-Forwarded-* headers. Use the addresses observed by the Xoboro container.
XOBORO_TRUSTED_PROXIES=

# Optional dedicated bearer token enabling the context-relative /metrics route.
# Use at least 32 random characters and do not reuse a user or API key.
XOBORO_METRICS_TOKEN=
