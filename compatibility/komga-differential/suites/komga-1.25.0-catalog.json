        "Content-Type": "application/json"
      },
      "body": "{\"condition\":{\"allOf\":[{\"tag\":{\"operator\":\"is\",\"value\":\"sample\"}},{\"numberSort\":{\"operator\":\"greaterThan\",\"value\":1}},{\"title\":{\"operator\":\"contains\",\"value\":\"Two\"}},{\"mediaStatus\":{\"operator\":\"is\",\"value\":\"READY\"}},{\"mediaProfile\":{\"operator\":\"is\",\"value\":\"DIVINA\"}},{\"author\":{\"operator\":\"is\",\"value\":{\"name\":\"Synthetic Author\",\"role\":\"writer\"}}}]}}",
