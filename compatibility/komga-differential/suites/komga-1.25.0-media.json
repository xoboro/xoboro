{
  "version": "1.25.0",
  "cases": [
    {
      "name": "synthetic page inventory",
      "path": "/api/v1/books/{BOOK_ID}/pages",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "JSON",
        "headers": ["Content-Length", "ETag", "Last-Modified"]
      }
    },
    {
      "name": "synthetic Divina manifest",
      "path": "/api/v1/books/{BOOK_ID}/manifest",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "JSON",
        "ignoreJsonPaths": [
          "/metadata/modified",
          "/links/*/href",
          "/readingOrder/*/href",
          "/resources/*/href"
        ]
      }
    },
    {
      "name": "synthetic selected book artwork",
      "path": "/api/v1/books/{BOOK_ID}/thumbnail",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Cache-Control",
          "Content-Length",
          "ETag"
        ]
      }
    },
    {
      "name": "synthetic OPDS v1 zero-based page",
      "path": "/opds/v1.2/books/{BOOK_ID}/pages/0",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Content-Disposition",
          "Content-Length",
          "ETag"
        ]
      }
    },
    {
      "name": "synthetic OPDS v2 one-based page",
      "path": "/opds/v2/books/{BOOK_ID}/pages/1",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Content-Disposition",
          "Content-Length",
          "ETag"
        ]
      }
    },
    {
      "name": "synthetic OPDS common thumbnail",
      "path": "/opds/v2/books/{BOOK_ID}/thumbnail",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Cache-Control",
          "Content-Length",
          "ETag"
        ]
      }
    },
    {
      "name": "synthetic archive download",
      "path": "/api/v1/books/{BOOK_ID}/file",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Content-Disposition",
          "Content-Length"
        ]
      }
    },
    {
      "name": "synthetic original page",
      "path": "/api/v1/books/{BOOK_ID}/pages/1",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Content-Disposition",
          "Content-Length",
          "ETag"
        ]
      }
    },
    {
      "name": "synthetic converted page",
      "path": "/api/v1/books/{BOOK_ID}/pages/1?convert=jpeg",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": [
          "Content-Disposition",
          "Content-Length",
          "ETag"
        ]
      }
    },
    {
      "name": "synthetic page thumbnail",
      "path": "/api/v1/books/{BOOK_ID}/pages/1/thumbnail",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "BINARY",
        "headers": ["Content-Length", "ETag"]
      }
    },
    {
      "name": "unsupported synthetic raw page",
      "path": "/api/v1/books/{BOOK_ID}/pages/1/raw",
      "pathVariables": ["BOOK_ID"],
      "comparison": {
        "bodyMode": "NONE"
      }
    }
  ]
}
