          "Cache-Control",
          "Content-Length",
          "ETag",
          "Vary",
          "X-Content-Type-Options",
          "X-XSS-Protection",
          "X-Frame-Options"
        ]
      }
    },
    {
      "name": "OpenAPI contract",
      "path": "/v3/api-docs",
      "comparison": {
        "bodyMode": "JSON",
        "compareContentType": true,
        "ignoreJsonPaths": [
          "/servers"
        ]
      }
    }
  ]
