{
  "version": "1.25.0",
  "cases": [
    {
      "name": "claim status",
      "path": "/api/v1/claim",
      "comparison": {
        "bodyMode": "JSON",
        "headers": [
          "Cache-Control",
          "Content-Length",
          "ETag",
          "Vary",
          "X-Content-Type-Options",
          "X-XSS-Protection",
          "X-Frame-Options"
        ]
      }
    },
    {
      "name": "OAuth2 providers",
      "path": "/api/v1/oauth2/providers",
      "comparison": {
        "bodyMode": "JSON",
        "compareContentType": true,
        "headers": [
          "Cache-Control",
          "Content-Length",
          "ETag",
          "Vary",
          "X-Content-Type-Options",
          "X-XSS-Protection",
          "X-Frame-Options"
        ]
      }
    },
    {
      "name": "configured CORS simple request",
      "path": "/api/v1/claim",
      "headers": {
        "Origin": "https://reader.example.invalid"
      },
      "comparison": {
        "bodyMode": "JSON",
        "headers": [
          "Access-Control-Allow-Origin",
          "Access-Control-Expose-Headers",
          "Access-Control-Allow-Credentials",
          "Cache-Control",
          "ETag",
          "Vary",
          "X-Content-Type-Options",
          "X-XSS-Protection",
          "X-Frame-Options"
        ]
      }
    },
    {
      "name": "configured CORS denied origin",
      "path": "/api/v1/claim",
      "headers": {
        "Origin": "https://denied.example.invalid"
      },
      "comparison": {
        "bodyMode": "TEXT",
        "compareContentType": false,
        "headers": [
          "Vary",
          "X-Content-Type-Options",
          "X-XSS-Protection",
          "X-Frame-Options"
        ]
      }
    },
    {
      "name": "configured CORS preflight",
      "method": "OPTIONS",
      "path": "/api/v1/claim",
      "headers": {
        "Origin": "https://reader.example.invalid",
        "Access-Control-Request-Method": "PATCH",
        "Access-Control-Request-Headers": "X-Synthetic, Content-Type"
      },
      "comparison": {
        "bodyMode": "NONE",
        "compareContentType": false,
        "headers": [
          "Access-Control-Allow-Origin",
          "Access-Control-Allow-Methods",
          "Access-Control-Allow-Headers",
          "Access-Control-Expose-Headers",
          "Access-Control-Allow-Credentials",
          "Access-Control-Max-Age",
          "Vary",
          "X-Content-Type-Options",
          "X-XSS-Protection",
          "X-Frame-Options"
        ]
      }
    },
    {
      "name": "OpenAPI contract",
      "path": "/v3/api-docs",
      "comparison": {
        "bodyMode": "JSON",
        "compareContentType": true,
        "ignoreJsonPaths": [
          "/servers"
        ]
      }
    },
    {
      "name": "REST authentication required",
      "path": "/api/v1/books",
      "comparison": {
        "bodyMode": "JSON",
        "headers": ["WWW-Authenticate"],
        "ignoreJsonPaths": ["/timestamp"]
      }
    },
    {
      "name": "invalid Basic credentials",
      "path": "/api/v1/books",
      "headers": {
        "Authorization": "Basic aW52YWxpZEBleGFtcGxlLmludmFsaWQ6aW52YWxpZC1wYXNzd29yZA=="
      },
      "comparison": {
        "bodyMode": "JSON",
        "headers": ["WWW-Authenticate"],
        "ignoreJsonPaths": ["/timestamp"]
      }
    },
    {
      "name": "OPDS v1 authentication required",
      "path": "/opds/v1.2/catalog",
      "comparison": {
        "bodyMode": "JSON",
        "headers": ["WWW-Authenticate"],
        "ignoreJsonPaths": ["/timestamp"]
      }
    },
    {
      "name": "OPDS v2 authentication document challenge",
      "path": "/opds/v2/catalog",
      "comparison": {
        "bodyMode": "JSON",
        "headers": ["WWW-Authenticate"],
        "ignoreJsonPaths": ["/id", "/links/1/href"]
      }
    }
  ]
}
